{
    "compilerOptions": {
        "target": "ES2024",
        "module": "node20",
        "allowJs": false,
        "declaration": true,
        "sourceMap": false,
        "moduleResolution": "node16",
        "strict": true,
        "noImplicitAny": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "types": ["node"],
		"outDir": "./build",
		"rootDir": "./src"
    },
	"include": [
		"src/**/*.ts"
    ],
	"exclude": [
		"node_modules/**"
	]
}